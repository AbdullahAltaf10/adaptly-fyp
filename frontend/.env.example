# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed so a fresh clone knows
# what configuration the frontend expects.

# Firebase web config (Firebase console > Project settings > Your apps).
# These are not secrets — they ship in the client bundle — but they are
# per-project, so they live in config rather than in source.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Backend API base URL. Defaults to http://127.0.0.1:8000 if unset.
VITE_API_URL=http://127.0.0.1:8000
