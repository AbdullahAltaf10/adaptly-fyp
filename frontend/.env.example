# Backend base URL. Falls back to http://127.0.0.1:8000 when unset.
VITE_API_URL=http://127.0.0.1:8000

# Firebase web app config (Project settings -> Your apps -> SDK setup).
# These are public client identifiers, not secrets, but keep them out of git
# so each developer points at their own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
