# Copy to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.

# --- MongoDB ---
# Atlas connection string (Atlas UI > Connect > Drivers).
# URL-encode any special characters in the password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=adaptly

# --- OpenAI (optional) ---
# Only used by the uploaded-video transcription endpoint, which returns
# HTTP 503 while this is empty. Left blank during development to avoid cost.
OPENAI_API_KEY=

# --- Firebase ---
# Path to the service account key. Optional: defaults to
# app/auth/firebase-service-account.json. The key itself is gitignored.
FIREBASE_SERVICE_ACCOUNT=

# --- HR administrator bootstrap ---
# The HR administrator role can read other employees' records, so nobody may
# self-assign it. Only the addresses listed here can register with that role.
#
# Normally this holds ONE address, used to create the first HR account; that
# person then grants the role to others from inside the app. Left empty, nobody
# can become an HR administrator at all.
#
# Separate several with commas:
#   HR_ADMIN_EMAILS=you@example.com,colleague@example.com
HR_ADMIN_EMAILS=
