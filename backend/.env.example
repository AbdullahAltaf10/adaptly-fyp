# Copy to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.

# --- MongoDB ---
# Atlas connection string (Atlas UI > Connect > Drivers).
# URL-encode any special characters in the password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=adaptly

# --- OpenAI (optional) ---
# Only used by the uploaded-video transcription endpoint, which returns
# HTTP 503 while this is empty. Left blank during development to avoid cost.
OPENAI_API_KEY=

# --- Gemini (Module 4 adaptive intervention, Module 5 assistant, Module 8 insight reports) ---
# Get a key from https://aistudio.google.com/apikey  (free tier is enough).
#
# Module 4 uses it to rewrite a paragraph more simply and to turn one into
# bullets. Without it, bullets fall back to extractive summarisation and
# simplification REFUSES rather than handing back the original text pretending
# it was simplified.
#
# Module 5's assistant and Module 8's insight-report generation
# (POST /api/sessions/{id}/insight-report/retry) read the same key and model.
# Left blank during development to avoid cost — Module 8 treats an empty key
# as a normal state that routes straight to the deterministic fallback report,
# not an error. Free tier is 20 requests/day/model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Timeout for Module 4/5's Gemini calls, in milliseconds.
GEMINI_TIMEOUT_MS=60000
# Timeout for Module 8's insight-report Gemini calls, in seconds.
GEMINI_TIMEOUT_SECONDS=20

# Module 5's assistant. Defaults to `mock` when this is unset - and mock returns
# a fixed placeholder sentence to every learner even when GEMINI_API_KEY is set,
# so a fresh setup looks like a broken assistant with nothing to explain why.
# Set to `gemini` to use the real model.
ASSISTANT_MODE=gemini

# Set to `mock` to guarantee no request ever leaves this machine, even with a
# key present. Anything else (or unset) means: use Gemini when a key is there.
INTERVENTION_CONTENT_MODE=auto

# --- Firebase ---
# Path to the service account key. Optional: defaults to
# app/auth/firebase-service-account.json. The key itself is gitignored.
FIREBASE_SERVICE_ACCOUNT=

# --- HR administrator bootstrap ---
# The HR administrator role can read other employees' records, so nobody may
# self-assign it. Only the addresses listed here can register with that role.
#
# Normally this holds ONE address, used to create the first HR account; that
# person then grants the role to others from inside the app. Left empty, nobody
# can become an HR administrator at all.
#
# Separate several with commas:
#   HR_ADMIN_EMAILS=you@example.com,colleague@example.com
HR_ADMIN_EMAILS=

# --- Device-verification email (2FA) ---
# Sends the 6-digit "verify this device" code. Uses a Gmail app password, not
# your real Gmail password: turn on 2-Step Verification on the sending
# account, then generate one at https://myaccount.google.com/apppasswords.
# Left blank, /auth/2fa/send returns 503 rather than a confusing SMTP error.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=Adaptly

# --- Passkey sign-in (WebAuthn) ---
# WEBAUTHN_ORIGIN must be the EXACT origin the frontend is served from,
# scheme+host+port — WebAuthn refuses a mismatch by spec. Vite's default is
# 5173, but it moves to the next free port if that one is taken; check the
# terminal Vite prints on startup and update this if it differs.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Adaptly
WEBAUTHN_ORIGIN=http://localhost:5173
