# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# MongoDB Atlas connection string.
# On Windows this also requires certifi (already in requirements.txt) —
# without tlsCAFile=certifi.where() in db.py, writes silently fail to appear.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=adaptly

# Optional. Only needed for the uploaded-video transcription endpoint,
# which returns HTTP 503 until this is set. Left unset during development
# to avoid API costs.
OPENAI_API_KEY=
