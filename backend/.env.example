# Copy this file to backend/.env and put your real values in.
# backend/.env is gitignored and must NEVER be uploaded to GitHub.

# --- Database ---
# Your MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=adaptly

# --- Optional: video transcription ---
# Only used by the "upload video" feature. That endpoint returns an error
# (HTTP 503) while this is empty, which is expected. Left blank to avoid cost.
OPENAI_API_KEY=

# --- HR administrator bootstrap ---
# Nobody can make themselves an HR administrator by asking for it, because that
# role can see other employees' records. Only the email addresses listed here
# are allowed to register as one. Separate several with commas.
#
# Normally you set ONE address here to create your first HR account, then that
# person grants the role to anyone else from inside the app. Leave it empty and
# nobody can become an HR administrator at all.
#
# Example:  HR_ADMIN_EMAILS=you@example.com,colleague@example.com
# Path override for the Firebase key (optional; defaults to app/auth/firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT=

HR_ADMIN_EMAILS=
