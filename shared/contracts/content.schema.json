{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptly.local/schemas/content.schema.json",
  "title": "Adaptly Processed Content",
  "description": "Shared format for content after upload and processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "user_id",
    "content_type",
    "title",
    "status",
    "language",
    "warnings",
    "chunks",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "enum": [
        "pdf",
        "research_paper",
        "plain_text",
        "website",
        "youtube",
        "uploaded_video"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "failed"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technical_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "order",
          "text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "section_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "start_time_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_time_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "is_critical": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}