{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptly.local/schemas/user-profile.schema.json",
  "title": "Adaptly User Profile",
  "description": "Shared format for learner and administrator profile information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "email",
    "account_type",
    "accessibility_settings",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "display_name": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "account_type": {
      "type": "string",
      "enum": ["learner", "admin", "employee", "hr_admin"]
    },
    "accessibility_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font",
        "line_spacing",
        "high_contrast",
        "focus_isolation"
      ],
      "properties": {
        "font": {
          "type": "string",
          "enum": ["default", "opendyslexic"]
        },
        "line_spacing": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "high_contrast": {
          "type": "boolean"
        },
        "focus_isolation": {
          "type": "boolean"
        }
      }
    },
    "study_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_content_mode": {
          "type": "string",
          "enum": ["text", "audio", "mixed"]
        },
        "voice_responses_enabled": {
          "type": "boolean"
        },
        "preferred_voice_speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}